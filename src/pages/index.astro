---
export const prerender = false;

import PostList from "../components/PostList";
import Layout from "../layouts/Layout.astro";
import { api } from "../../convex/_generated/api";
import { getConvexHttpClient } from "../lib/convex-server";

const client = getConvexHttpClient();
const posts = client ? await client.query(api.posts.listPublished, {}) : [];
const initialPosts = posts.map((post) => ({
  slug: post.slug,
  title: post.title,
  description: post.description,
  pubDate: post.pubDate,
  heroImageUrl: post.heroImageUrl,
}));
---

<Layout title="Elder Pickle" description="Notes from Elder Pickle.">
  <h1 class="hero-title">Elder Pickle</h1>
  <p class="lede">
    Short notes from Elder Pickle. Comments welcome if you are signed in.
  </p>

  {
    !client ? (
      <p class="muted">
        Posts are unavailable until <code>PUBLIC_CONVEX_URL</code> is configured.
      </p>
    ) : (
      <PostList client:load initialPosts={initialPosts} />
    )
  }
</Layout>
