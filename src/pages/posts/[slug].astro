---
export const prerender = false;

import Comments from "../../components/Comments";
import PostArticle from "../../components/PostArticle";
import Layout from "../../layouts/Layout.astro";
import { api } from "../../../convex/_generated/api";
import { getConvexHttpClient } from "../../lib/convex-server";
import { renderMarkdocToHtml } from "../../lib/render-markdoc";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/");
}

const client = getConvexHttpClient();
if (!client) {
  return new Response("Convex is not configured.", {
    status: 503,
    statusText: "Service Unavailable",
  });
}

const post = await client.query(api.posts.getBySlug, { slug });
if (!post) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const bodyHtml = renderMarkdocToHtml(post.bodyMarkdoc);
const postUrl = new URL(`/posts/${post.slug}/`, Astro.site ?? Astro.url).href;
---

<Layout title={post.title} description={post.description}>
  <PostArticle
    client:load
    slug={post.slug}
    initialTitle={post.title}
    initialPubDate={post.pubDate}
    initialHeroImageUrl={post.heroImageUrl}
    initialBodyHtml={bodyHtml}
  />

  <Comments
    client:load
    postSlug={post.slug}
    postTitle={post.title}
    postUrl={postUrl}
  />
</Layout>
