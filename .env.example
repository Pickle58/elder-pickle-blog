# Clerk (Astro)
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Your Clerk user id (Dashboard → Users). Used for admin UI + Convex checks.
PUBLIC_ADMIN_CLERK_USER_ID=
# Same value — set in the Convex dashboard as ADMIN_CLERK_USER_ID

# Convex
PUBLIC_CONVEX_URL=
# Convex dashboard env:
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# ADMIN_CLERK_USER_ID=
# COMMENT_NOTIFY_SECRET=
# NOTIFY_WORKER_URL=https://email-with-resend.<subdomain>.workers.dev/notify-comment

# Optional site URL for absolute links in emails (set when deploying)
# SITE=https://elderpickle.com
