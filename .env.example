# Clerk (Astro)
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Your Clerk user id (Dashboard → Users). Used for admin UI + Convex checks.
PUBLIC_ADMIN_CLERK_USER_ID=
# Same value — set in the Convex dashboard as ADMIN_CLERK_USER_ID

# Convex
PUBLIC_CONVEX_URL=
# Convex dashboard env:
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# ADMIN_CLERK_USER_ID=
# COMMENT_NOTIFY_SECRET=
# NOTIFY_WORKER_URL=https://email-with-resend.<subdomain>.workers.dev/notify-comment
# GitHub → Convex post ingest (Keystatic saves commit to master):
# GITHUB_WEBHOOK_SECRET=          # webhook signing secret
# GITHUB_TOKEN=                   # classic/fine-grained PAT with contents:read + contents:write (write for admin post delete)
# Webhook URL: https://<deployment>.convex.site/github/keystatic  (events: push)

# Optional site URL for absolute links in emails (set when deploying)
# SITE=https://elderpickle.com

# Keystatic (GitHub mode — required for Cloudflare/workerd; used in DEV and production).
# Create a GitHub App per https://keystatic.com/docs/github-mode
# Local callback: http://127.0.0.1:4321/api/keystatic/github/oauth/callback
# Production callback: https://<your-host>/api/keystatic/github/oauth/callback
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
